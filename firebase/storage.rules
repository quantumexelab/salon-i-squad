rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasUserDoc() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMaster() {
      return hasUserDoc() && userRole() == 'master';
    }

    function isStaff() {
      return hasUserDoc() && (userRole() == 'admin' || userRole() == 'master');
    }

    match /services/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == userId || isStaff())
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Staff/owner may delete style or avatar objects when replacing.
      allow delete: if request.auth != null
        && (request.auth.uid == userId || isStaff());
    }

    // System logo — public read, master write only.
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isMaster()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
