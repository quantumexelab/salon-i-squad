# --- Option A: Local emulators (no Google account needed) ---
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-salon-i-squad.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-salon-i-squad
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-salon-i-squad.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# --- Option B: Production Firebase (from Firebase Console) ---
# Project Settings → General → Your apps → Web app config

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Project Settings → Cloud Messaging → Web Push certificates (VAPID key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Public site URL (required for FCM webpush click links — must be https)
# NEXT_PUBLIC_SITE_URL=https://salon-i-squad.vercel.app

# --- Email (Resend) — welcome, booking confirm, 1h reminders ---
# Create API key: https://resend.com
# For production, verify your domain and set EMAIL_FROM to that domain.
RESEND_API_KEY=
EMAIL_FROM=Salon I Squad <onboarding@resend.dev>

# --- Firebase Admin (required on Vercel for FCM push + staff reminder test API) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the full JSON as a single-line string:
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Appointment reminders (GitHub Actions → GET /api/whatsapp/reminders) ---
# Same value in Vercel env AND GitHub repo secret CRON_SECRET
CRON_SECRET=

# Temporary admin "Test reminder (2 min)" button. Set to false to hide after debugging.
# NEXT_PUBLIC_ALLOW_REMINDER_TEST=false

# --- WhatsApp Cloud API (Meta) — chatbot + admin booking alerts ---
# WHATSAPP_ACCESS_TOKEN= (or META_API_TOKEN)
# WHATSAPP_PHONE_NUMBER_ID=
# Salon owner number for new-booking alerts (digits only, e.g. 94752087304)
# SALON_OWNER_WHATSAPP=
# Approved Meta utility template for 1h reminders (outside 24h chat window)
# Body variables: {{1}} appointment #, {{2}} service, {{3}} time
# WHATSAPP_REMINDER_TEMPLATE=appointment_reminder
